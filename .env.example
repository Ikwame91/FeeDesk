# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Local .env and Netlify each need
# both secrets below. Generate each one separately with `openssl rand -hex 32`.
# Do not reuse one value for both. Leave these empty in the repo.
# BETTER_AUTH_SECRET=
# SECRETS_ENCRYPTION_KEY=
# AUTH_DISABLED=true
